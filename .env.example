# Copy to .env (never commit it) and fill in. Load with:  node --env-file=.env server.js
PORT=3000
HOST=0.0.0.0
BASE_URL=https://calendar.example.com      # the public https address of your site

# Google sign-in + calendars (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: ${BASE_URL}/auth/google/callback

# Microsoft sign-in + Outlook calendars (Entra admin center -> App registrations -> New registration)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Redirect URI to register: ${BASE_URL}/auth/microsoft/callback

# Long random string that protects sessions and encrypts stored tokens. Keep it safe; changing it signs everyone out.
APP_SECRET=
DB_FILE=/data/data.sqlite

# Android app (fill in after you build it, see README)
ANDROID_PACKAGE=com.example.unifiedcalendar
ANDROID_SHA256=
